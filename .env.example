# ---- Supabase (public: needed at build time AND runtime) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use EITHER the newer publishable key OR the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Plunk (server-only: runtime) ----
PLUNK_SECRET_KEY=sk_your_plunk_secret_key

# ---- Background worker (server-only: runtime) ----
# Service-role key bypasses RLS. Only the worker container uses it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Redis / BullMQ (server-only: runtime) ----
# Inside docker-compose the service name is `redis`.
REDIS_URL=redis://redis:6379

# ---- Web Push (VAPID) ----
# Generate a keypair with:  npx web-push generate-vapid-keys
# The public key is exposed to the browser; keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:registrations@witscsd.co.za

# ---- Optional ----
# NEXT_PUBLIC_PLUNK_PUBLIC_KEY=pk_your_plunk_public_key
